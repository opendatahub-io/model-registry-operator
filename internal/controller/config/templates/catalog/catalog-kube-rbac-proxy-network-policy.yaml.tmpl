apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app: {{.Name}}
    component: model-catalog
    app.kubernetes.io/name: {{.Name}}
    app.kubernetes.io/instance: {{.Name}}-https-route
    app.kubernetes.io/component: model-catalog
    app.kubernetes.io/created-by: model-registry-operator
    app.kubernetes.io/part-of: model-catalog
    app.kubernetes.io/managed-by: model-registry-operator
  name: {{.Name}}-https-route
  namespace: {{.Namespace}}
spec:
  ingress:
  - from:
    # OpenShift router and Gateway API traffic for the Route / HTTPRoute exposure paths. Dashboard callers
    # (model-registry-ui BFF) reach the catalog through these paths via the external-address-rest annotation;
    # no workload in the shared applications namespace calls the catalog pod-to-pod.
    - namespaceSelector:
        matchLabels:
          network.openshift.io/policy-group: ingress
    ports:
      - protocol: TCP
        port: {{.Spec.KubeRBACProxy.Port}}
  podSelector:
    matchLabels:
      app: {{.Name}}
      component: model-catalog
      app.kubernetes.io/name: {{.Name}}
  policyTypes:
  - Ingress

