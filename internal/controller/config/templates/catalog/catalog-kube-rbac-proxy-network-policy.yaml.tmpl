apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app: {{.Name}}
    component: model-catalog
    app.kubernetes.io/name: {{.Name}}
    app.kubernetes.io/instance: {{.Name}}-https-route
    app.kubernetes.io/component: model-catalog
    app.kubernetes.io/created-by: model-registry-operator
    app.kubernetes.io/part-of: model-catalog
    app.kubernetes.io/managed-by: model-registry-operator
  name: {{.Name}}-https-route
  namespace: {{.Namespace}}
spec:
  ingress:
  - from:
    # OpenShift router and Gateway API traffic for the Route / HTTPRoute exposure paths.
    - namespaceSelector:
        matchLabels:
          network.openshift.io/policy-group: ingress
    {{- if .ApplicationsNamespace}}
    # model-registry-ui BFF in the shared applications namespace calls the catalog pod-to-pod using the
    # in-cluster Service host, avoiding external gateway hairpins. The namespace is matched by name because
    # opendatahub.io/generated-namespace is also applied to tenant namespaces, and the peer also requires the
    # pod's stable Deployment selector label, owned by the Dashboard team.
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{.ApplicationsNamespace}}
      podSelector:
        matchLabels:
          deployment: model-registry-ui
    {{- end}}
    ports:
      - protocol: TCP
        port: {{.Spec.KubeRBACProxy.Port}}
  podSelector:
    matchLabels:
      app: {{.Name}}
      component: model-catalog
      app.kubernetes.io/name: {{.Name}}
  policyTypes:
  - Ingress

