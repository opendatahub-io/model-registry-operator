# Deny all egress from the catalog postgres pod; it only serves inbound connections.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app: {{.Name}}
    app.kubernetes.io/name: {{.Name}}-postgres
    app.kubernetes.io/instance: {{.Name}}-postgres-egress
    app.kubernetes.io/component: {{.Name}}
    app.kubernetes.io/created-by: model-registry-operator
    app.kubernetes.io/part-of: model-catalog
    app.kubernetes.io/managed-by: model-registry-operator
  name: {{.Name}}-postgres-egress
  namespace: {{.Namespace}}
spec:
  podSelector:
    matchLabels:
      app: {{.Name}}
      component: {{.Name}}
      app.kubernetes.io/name: {{.Name}}-postgres
  policyTypes:
  - Egress
  egress: []
