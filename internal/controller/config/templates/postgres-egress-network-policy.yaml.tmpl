# Deny all egress from the operator-managed postgres pod; it only serves inbound connections.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  labels:
    app: {{.Name}}-postgres
    component: model-registry-postgres
    app.kubernetes.io/name: {{.Name}}-postgres
    app.kubernetes.io/instance: {{.Name}}-postgres-egress
    app.kubernetes.io/component: database
    app.kubernetes.io/created-by: model-registry-operator
    app.kubernetes.io/part-of: model-registry
    app.kubernetes.io/managed-by: model-registry-operator
  name: {{.Name}}-postgres-egress
  namespace: {{.Namespace}}
spec:
  podSelector:
    matchLabels:
      app: {{.Name}}
      component: model-registry
      app.kubernetes.io/name: {{.Name}}-postgres
  policyTypes:
  - Egress
  egress: []
